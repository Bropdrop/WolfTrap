{
  "schema_version": "1.0",
  "scenario_id": "fbi-artex-simulated-credential-persistence",
  "scenario_version": "1.0.0",
  "title": "Unregistered persisted credential presentation",
  "summary": "A synthetically verified but unregistered credential identifier is presented after a simulated credential addition.",
  "category": "credential-persistence",
  "threat": {
    "source": {
      "source_id": "FBI-FLASH-20261113-001",
      "title": "Threat Overview of ARTEX Autonomous Penetration Testing Framework",
      "publication_date": "2026-11-13",
      "url": "https://www.ic3.gov/CSA/2026/261113.pdf",
      "sha256": "3dd86a94d33b29c65f56b4307919b74358e63cfde33a600b61adce5794d169e2",
      "pages": [4, 9, 10],
      "observed_behavior": "Observed persistence included credentials added to existing OAuth applications and SSH keys; mitigations call for monitoring credential additions and rotating unauthorized credentials.",
      "mapping_note": "No credential is added to a real account. The substituted identifier exists only in this in-memory experiment."
    },
    "attack": [
      {
        "technique_id": "T1098.001",
        "name": "Account Manipulation: Additional Cloud Credentials",
        "url": "https://attack.mitre.org/techniques/T1098/001/",
        "relationship": "DIRECT"
      },
      {
        "technique_id": "T1078.004",
        "name": "Valid Accounts: Cloud Accounts",
        "url": "https://attack.mitre.org/techniques/T1078/004/",
        "relationship": "UNDERLYING_OPERATION"
      }
    ]
  },
  "fixtures": {
    "current_epoch": 9,
    "security_state_known": true,
    "principals": [
      {"principal_id": "principal-persistence-app", "roles": ["application"]}
    ],
    "authorizations": [
      {
        "authorization_id": "auth-persistence-registered",
        "subject": "principal-persistence-app",
        "scopes": ["add_credential:synthetic://applications/persistence"],
        "epoch": 9,
        "origin_binding": "synthetic-origin://application/persistence",
        "operation_digest": "@operation:op-persistence-add",
        "issued_at": 0,
        "expires_at": 100,
        "signature_valid": true,
        "nonce": "nonce-persistence-registered"
      }
    ],
    "operations": [
      {
        "operation_id": "op-persistence-add",
        "action": "add_credential",
        "resource": "synthetic://applications/persistence",
        "arguments": {"credential_label": "synthetic-persisted-key"},
        "protected": true
      }
    ]
  },
  "requests": [
    {
      "request_id": "req-persistence-unregistered",
      "principal_id": "principal-persistence-app",
      "authorization_id": "auth-persistence-registered",
      "operation_id": "op-persistence-add",
      "origin": "synthetic-origin://application/persistence",
      "credential_overrides": {
        "authorization_id": "auth-persistence-unregistered",
        "nonce": "nonce-persistence-unregistered"
      }
    }
  ],
  "actions": [
    {"kind": "SUBMIT", "at": 10, "task_id": "task-persistence", "request_id": "req-persistence-unregistered"},
    {"kind": "ADVANCE", "at": 10, "task_id": "task-persistence", "repeat": 2}
  ],
  "expectation": {
    "control": "NEGATIVE",
    "description": "Credential verification alone is insufficient: an unregistered current authority produces no credential-addition effect.",
    "invariants": ["NO_CURRENT_AUTHORITY_NO_PROTECTED_EFFECT", "VERIFIED_DOES_NOT_MEAN_AUTHORIZED"]
  },
  "mutation_axes": ["principal_identity", "permission_scope", "authorization_epoch", "operation_digest", "retry_recovery", "scenario_composition"]
}
