    ],
    "operations": [
      {
        "operation_id": "op-concurrent-write",
        "action": "write",
        "resource": "synthetic://ledger/concurrent",
        "arguments": {"value": "bounded-synthetic-value"},
        "protected": true
      }
    ]
  },
  "requests": [
    {
      "request_id": "request-concurrent",
      "principal_id": "principal-concurrent",
