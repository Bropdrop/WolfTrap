      "sha256": "3dd86a94d33b29c65f56b4307919b74358e63cfde33a600b61adce5794d169e2",
      "pages": [2, 9],
      "observed_behavior": "The advisory describes concurrent campaigns and evidence of multiple sub-agents overwriting one another or generating duplicate requests.",
      "mapping_note": "Concurrency is an FBI-inspired engineering stressor, not a standalone ATT&CK technique; T1078 labels the valid-account operation being stressed."
    },
    "attack": [
      {
        "technique_id": "T1078",
        "name": "Valid Accounts",
