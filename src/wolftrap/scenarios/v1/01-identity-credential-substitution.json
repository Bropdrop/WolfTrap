{
  "schema_version": "1.0",
  "scenario_id": "fbi-artex-identity-credential-substitution",
  "scenario_version": "1.0.0",
  "title": "Identity impersonation and credential-claim substitution",
  "summary": "A verified synthetic credential is presented by the wrong principal, and a second presentation alters its signed subject claim.",
  "category": "identity-impersonation",
  "threat": {
    "source": {
      "source_id": "FBI-FLASH-20261113-001",
      "title": "Threat Overview of ARTEX Autonomous Penetration Testing Framework",
      "publication_date": "2026-11-13",
      "url": "https://www.ic3.gov/CSA/2026/261113.pdf",
      "sha256": "3dd86a94d33b29c65f56b4307919b74358e63cfde33a600b61adce5794d169e2",
      "pages": [3, 4, 5],
      "observed_behavior": "The advisory reports unsigned SAML assertions, compromised vendor credentials, leaked credentials, forged administrator tokens, and alternate authentication material.",
      "mapping_note": "The experiment models only local credential/principal binding; it does not reproduce SAML forgery, credential theft, or external authentication."
    },
    "attack": [
      {
        "technique_id": "T1078",
        "name": "Valid Accounts",
        "url": "https://attack.mitre.org/techniques/T1078/",
        "relationship": "DIRECT"
      },
      {
        "technique_id": "T1606.002",
        "name": "Forge Web Credentials: SAML Tokens",
        "url": "https://attack.mitre.org/techniques/T1606/002/",
        "relationship": "DIRECT"
      }
    ]
  },
  "fixtures": {
    "current_epoch": 3,
    "security_state_known": true,
    "principals": [
      {"principal_id": "principal-identity-analyst", "roles": ["analyst"]},
      {"principal_id": "principal-identity-impostor", "roles": ["untrusted"]}
    ],
    "authorizations": [
      {
        "authorization_id": "auth-identity-read",
        "subject": "principal-identity-analyst",
        "scopes": ["read:synthetic://records/identity"],
        "epoch": 3,
        "origin_binding": "synthetic-origin://workstation/identity",
        "operation_digest": "@operation:op-identity-read",
        "issued_at": 0,
        "expires_at": 100,
        "signature_valid": true,
        "nonce": "nonce-identity-read"
      }
    ],
    "operations": [
      {
        "operation_id": "op-identity-read",
        "action": "read",
        "resource": "synthetic://records/identity",
        "arguments": {"record_id": "synthetic-identity-record"},
        "protected": true
      }
    ]
  },
  "requests": [
    {
      "request_id": "req-identity-impostor",
      "principal_id": "principal-identity-impostor",
      "authorization_id": "auth-identity-read",
      "operation_id": "op-identity-read",
      "origin": "synthetic-origin://workstation/identity",
      "credential_overrides": {}
    },
    {
      "request_id": "req-identity-substituted-claim",
      "principal_id": "principal-identity-analyst",
      "authorization_id": "auth-identity-read",
      "operation_id": "op-identity-read",
      "origin": "synthetic-origin://workstation/identity",
      "credential_overrides": {"subject": "principal-identity-impostor"}
    }
  ],
  "actions": [
    {"kind": "SUBMIT", "at": 10, "task_id": "task-identity-impostor", "request_id": "req-identity-impostor"},
    {"kind": "ADVANCE", "at": 10, "task_id": "task-identity-impostor", "repeat": 2},
    {"kind": "SUBMIT", "at": 11, "task_id": "task-identity-substitution", "request_id": "req-identity-substituted-claim"},
    {"kind": "ADVANCE", "at": 11, "task_id": "task-identity-substitution", "repeat": 2}
  ],
  "expectation": {
    "control": "NEGATIVE",
    "description": "Neither a principal mismatch nor a modified credential claim may create a protected effect, even when verification is true.",
    "invariants": ["NO_CURRENT_AUTHORITY_NO_PROTECTED_EFFECT", "VERIFIED_DOES_NOT_MEAN_AUTHORIZED"]
  },
  "mutation_axes": ["principal_identity", "authorization_epoch", "operation_digest", "scenario_composition"]
}
